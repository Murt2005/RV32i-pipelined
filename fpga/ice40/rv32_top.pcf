# iCE40 package pin numbers (not RP2350 GPIOs), from pico-ice-sdk/rtl/pico2_ice.pcf

set_io -nowarn clk      35
set_io -nowarn -pullup yes reset_n 10

set_io -nowarn rx_pin   9
set_io -nowarn tx_pin   11

# RGB LED, active low. Only the FPGA drives it; the firmware must not
set_io -nowarn led_g_n  39
set_io -nowarn led_b_n  40
set_io -nowarn led_r_n  41
